# 複製成 .env 後填入
ANTHROPIC_API_KEY=
# 選填：Google PageSpeed Insights API key（沒有也能跑，但容易被限流）
PSI_API_KEY=
# 選填：預設使用 claude-opus-5-5
CLAUDE_MODEL=claude-opus-5-5
PORT=3000

# 選填：key 沒綁定 workspace 時填入
ANTHROPIC_WORKSPACE_ID=

# ── AI 平台追蹤（每個平台填了 key 才會啟用）──
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Google AI 總覽要透過 SerpAPI
SERPAPI_KEY=
# 追蹤時 Claude 使用的模型（預設同 CLAUDE_MODEL）；設 TRACK_CLAUDE=off 可不追蹤 Claude
CLAUDE_TRACK_MODEL=
TRACK_CLAUDE=
# 每題每個平台每輪問幾次（預設 1）
TRACK_RUNS=1

# ── 正式環境 ──
# 登入帳密（設定密碼後全站需要登入；NODE_ENV=production 時必填）
AUTH_USER=admin
AUTH_PASSWORD=
